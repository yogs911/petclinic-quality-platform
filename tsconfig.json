{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@pages/*": ["./src/pages/*"],
      "@components/*": ["./src/components/*"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@api/*": ["./src/api/*"],
      "@data/*": ["./src/data/*"],
      "@helpers/*": ["./src/helpers/*"],
      "@types/*": ["./src/types/*"],
      "@config/*": ["./config/*"]
    }
  },
  "include": ["src/**/*", "pages/**/*", "tests/**/*", "config/**/*", "playwright.config.ts"],
  "exclude": ["node_modules", "dist"]
}